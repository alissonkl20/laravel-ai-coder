# Modelo Unsloth 4-bit (menos VRAM que Qwen/Qwen2.5-Coder-7B-Instruct)
MODEL_NAME=unsloth/Qwen2.5-Coder-7B-Instruct-bnb-4bit

# Contexto máximo (1536 na RTX 3060; use 1024 se ainda der erro de VRAM)
MAX_SEQ_LENGTH=1536

# Diretório onde o adaptador LoRA será salvo após o treino
LORA_OUTPUT_DIR=./outputs_lora

# Dataset JSONL para fine-tuning
DATASET_PATH=./data/raw_dataset.jsonl
# Steps de QLoRA (400 no mix E2E; 300 era o LoRA anterior)
MAX_STEPS=400

# Nome exibido do agente (CLI e prompts)
AGENT_NAME=DRAXY

# Comportamento da LLM (idioma e tolerância a erros)
LLM_MULTILINGUAL=true
LLM_DEFAULT_LANGUAGE=pt
LLM_TYPO_TOLERANCE=true
LLM_RESPOND_IN_PROMPT_LANGUAGE=true

# Agent CLI — pasta base com todos os projetos (~/Documentos)
AGENT_PROJECTS_ROOT=/home/alisson/Documentos
# Projeto padrão ao iniciar (my-app, atendimento-whatsapp, etc.)
AGENT_DEFAULT_PROJECT=my-app
# Legado: se apontar a um projeto Laravel específico, também funciona
AGENT_WORKSPACE=/home/alisson/Documentos
AGENT_SHORTCUTS_PATH=./config/agent_shortcuts.json
AGENT_MAX_ITERATIONS=20
AGENT_TEMPERATURE=0.2
AGENT_MAX_NEW_TOKENS=1024
AGENT_MAX_NEW_TOKENS_TOOL=256
AGENT_MAX_TOOL_OUTPUT_CHARS=2000
AGENT_HISTORY_STEPS=6
AGENT_CONVERSATION_TURNS=2
AGENT_COMMAND_TIMEOUT=60

# Splash ASCII compacto ao iniciar o agent (DRAXY)
AGENT_ASCII_SPLASH=false
AGENT_ASCII_SPLASH_WIDTH=44
AGENT_ASCII_SPLASH_HEIGHT=10

# Modos Cursor-like: ask | plan | agent
AGENT_DEFAULT_MODE=agent
AGENT_SESSIONS_PATH=./data/sessions
# true = pede y/n + diff antes de write/shell sensível
AGENT_REQUIRE_APPROVAL=true

# Índice de busca + cache Redis (consultas repetidas não reabrem o JSONL)
AGENT_SEARCH_INDEX=./data/search_index.json
REDIS_URL=redis://127.0.0.1:6379/0
AGENT_CACHE_ENABLED=true
AGENT_CACHE_TTL=86400

AGENT_BENCH_JSONL=
